# Copied to deploy/.env. Ansible renders this file on servers; `make up` generates
# a local one with random secrets.

# Docker Hub repository of the application image.
APP_IMAGE_REPO=yourname/parkd

# Holds state.json, the deploy lock, the nginx routing include and secrets.
RS_RUNTIME_DIR=/var/lib/resilience

# Public entry point.
EDGE_BIND=0.0.0.0
EDGE_PORT=80

# Use letters and digits only: the password is embedded in a connection URL.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
